{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "App.test.tsx",
    "index.tsx",
    "types.ts",
    "vite.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "services/**/*.ts",
    "utils/**/*.ts",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "e2e/**/*.ts",
    "fixtures/**/*.ts"
  ]
}