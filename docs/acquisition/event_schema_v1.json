{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:autosafe:acquisition:event:v1",
  "title": "AutoSafe acquisition event v1 (PROPOSED - collection OFF; awaits OA-005)",
  "description": "Proposed safe-field event schema. scope_visible v1 means: scope disclosure text is available for this state (data-derived from the same copy function the UI uses; it does not observe the DOM). The visible card states prediction vs <make model> comparison vs dataset-wide reference; the exact_band/age_band_only/model_average distinction is inside a collapsed details element. v1 is therefore currently non-discriminating (true for every contract-valid report), pending a product decision before collection. If a render error occurs after result_rendered, both events can exist for one operation: aggregation must let render_failed win. No collector, storage, session persistence or retention is approved. Events are client-reported acknowledgements and prove neither accuracy nor model qualification. Never carries risk figures, sample counts, report identity, registration, postcode, make/model, URLs, referrers, error text or free text.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "metric_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event": {
          "const": "landing_observed"
        },
        "landing_path": {
          "type": "string",
          "pattern": "^/[a-z0-9/_-]{0,119}$",
          "not": {
            "pattern": "^/app/report"
          }
        },
        "source_group": {
          "enum": [
            "google_organic",
            "other_search",
            "direct",
            "referral",
            "unknown",
            "internal_test"
          ]
        },
        "observation_state": {
          "enum": [
            "observed",
            "consent_not_given",
            "unsupported"
          ]
        }
      },
      "required": [
        "schema_version",
        "metric_version",
        "event_id",
        "event",
        "landing_path",
        "source_group",
        "observation_state"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "metric_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event": {
          "const": "check_started"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entry_mode": {
          "const": "fresh_check"
        }
      },
      "required": [
        "schema_version",
        "metric_version",
        "event_id",
        "event",
        "operation_id",
        "entry_mode"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "metric_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event": {
          "const": "report_created"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entry_mode": {
          "const": "fresh_check"
        },
        "result_kind": {
          "enum": [
            "comparison",
            "vehicle_prediction"
          ]
        },
        "match_scope": {
          "enum": [
            "exact_band",
            "age_band_only",
            "model_average",
            "population_default",
            "unavailable",
            "model_prediction"
          ]
        },
        "persistence_mode": {
          "enum": [
            "saved",
            "inline_unsaved"
          ]
        }
      },
      "required": [
        "schema_version",
        "metric_version",
        "event_id",
        "event",
        "operation_id",
        "entry_mode",
        "result_kind",
        "match_scope",
        "persistence_mode"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "result_kind": {
                "const": "vehicle_prediction"
              }
            },
            "required": [
              "result_kind"
            ]
          },
          "then": {
            "properties": {
              "match_scope": {
                "const": "model_prediction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "match_scope": {
                "const": "model_prediction"
              }
            },
            "required": [
              "match_scope"
            ]
          },
          "then": {
            "properties": {
              "result_kind": {
                "const": "vehicle_prediction"
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "metric_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event": {
          "const": "result_rendered"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entry_mode": {
          "enum": [
            "fresh_check",
            "restored_link"
          ]
        },
        "persistence_mode": {
          "enum": [
            "saved",
            "inline_unsaved"
          ]
        },
        "render_delivered": {
          "const": true
        },
        "supported_result": {
          "type": "boolean"
        },
        "outcome_group": {
          "enum": [
            "prediction",
            "exact_comparison",
            "broader_supported_comparison",
            "dataset_reference"
          ]
        },
        "rate_valid": {
          "type": "boolean"
        },
        "sample_nonzero": {
          "type": "boolean"
        },
        "scope_visible": {
          "type": "boolean",
          "description": "v1: scope disclosure text available for this state (data-derived, non-discriminating, pending product decision)"
        },
        "result_kind": {
          "enum": [
            "comparison",
            "vehicle_prediction"
          ]
        },
        "match_scope": {
          "enum": [
            "exact_band",
            "age_band_only",
            "model_average",
            "population_default",
            "model_prediction"
          ]
        }
      },
      "required": [
        "schema_version",
        "metric_version",
        "event_id",
        "event",
        "entry_mode",
        "persistence_mode",
        "render_delivered",
        "supported_result",
        "outcome_group",
        "rate_valid",
        "scope_visible",
        "result_kind",
        "match_scope"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome_group": {
                "const": "prediction"
              }
            },
            "required": [
              "outcome_group"
            ]
          },
          "then": {
            "properties": {
              "result_kind": {
                "const": "vehicle_prediction"
              },
              "match_scope": {
                "const": "model_prediction"
              },
              "supported_result": {
                "const": true
              },
              "rate_valid": {
                "const": true
              },
              "scope_visible": {
                "const": true
              }
            },
            "not": {
              "required": [
                "sample_nonzero"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_group": {
                "const": "exact_comparison"
              }
            },
            "required": [
              "outcome_group"
            ]
          },
          "then": {
            "properties": {
              "result_kind": {
                "const": "comparison"
              },
              "match_scope": {
                "const": "exact_band"
              },
              "rate_valid": {
                "const": true
              }
            },
            "required": [
              "sample_nonzero"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome_group": {
                "const": "broader_supported_comparison"
              }
            },
            "required": [
              "outcome_group"
            ]
          },
          "then": {
            "properties": {
              "result_kind": {
                "const": "comparison"
              },
              "match_scope": {
                "enum": [
                  "age_band_only",
                  "model_average"
                ]
              },
              "rate_valid": {
                "const": true
              }
            },
            "required": [
              "sample_nonzero"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome_group": {
                "const": "dataset_reference"
              }
            },
            "required": [
              "outcome_group"
            ]
          },
          "then": {
            "properties": {
              "result_kind": {
                "const": "comparison"
              },
              "match_scope": {
                "const": "population_default"
              },
              "supported_result": {
                "const": false
              }
            },
            "required": [
              "sample_nonzero"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "match_scope": {
                "const": "model_prediction"
              }
            },
            "required": [
              "match_scope"
            ]
          },
          "then": {
            "properties": {
              "outcome_group": {
                "const": "prediction"
              }
            },
            "not": {
              "required": [
                "sample_nonzero"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "result_kind": {
                "const": "vehicle_prediction"
              }
            },
            "required": [
              "result_kind"
            ]
          },
          "then": {
            "properties": {
              "match_scope": {
                "const": "model_prediction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "supported_result": {
                "const": true
              }
            },
            "required": [
              "supported_result"
            ]
          },
          "then": {
            "properties": {
              "rate_valid": {
                "const": true
              },
              "scope_visible": {
                "const": true
              },
              "outcome_group": {
                "enum": [
                  "prediction",
                  "exact_comparison",
                  "broader_supported_comparison"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_group": {
                "enum": [
                  "exact_comparison",
                  "broader_supported_comparison"
                ]
              }
            },
            "required": [
              "outcome_group"
            ]
          },
          "then": {
            "if": {
              "properties": {
                "scope_visible": {
                  "const": true
                }
              },
              "required": [
                "scope_visible"
              ]
            },
            "then": {
              "properties": {
                "supported_result": {
                  "const": true
                },
                "sample_nonzero": {
                  "const": true
                }
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "metric_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event": {
          "const": "result_unavailable"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "entry_mode": {
          "enum": [
            "fresh_check",
            "restored_link"
          ]
        },
        "reason": {
          "enum": [
            "not_found",
            "expired",
            "unavailable",
            "error"
          ]
        }
      },
      "required": [
        "schema_version",
        "metric_version",
        "event_id",
        "event",
        "entry_mode",
        "reason"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "metric_version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
        },
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event": {
          "const": "check_failed"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
